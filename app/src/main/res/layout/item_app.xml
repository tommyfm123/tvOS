<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/tile_margin"
    android:layout_marginBottom="@dimen/tile_margin_bottom"
    android:clickable="true"
    android:defaultFocusHighlightEnabled="false"
    android:focusable="true"
    android:longClickable="true"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/tile_image"
        android:layout_width="@dimen/tile_width"
        android:layout_height="@dimen/tile_height"
        android:clipToOutline="true"
        android:elevation="@dimen/tile_elevation"
        android:foreground="@drawable/tile_border"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/tile_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="@dimen/label_margin_top"
        android:background="@drawable/label_chip"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:maxWidth="@dimen/tile_width"
        android:paddingHorizontal="@dimen/label_chip_padding_horizontal"
        android:paddingVertical="@dimen/label_chip_padding_vertical"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/label_text_size" />
</LinearLayout>
