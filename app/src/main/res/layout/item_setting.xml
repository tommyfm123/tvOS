<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/setting_card_margin"
    android:clickable="true"
    android:defaultFocusHighlightEnabled="false"
    android:focusable="true"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/tile_image"
        android:layout_width="@dimen/setting_card_size"
        android:layout_height="@dimen/setting_card_size"
        android:clipToOutline="true"
        android:elevation="@dimen/tile_elevation"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/tile_label"
        android:layout_width="@dimen/setting_card_size"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/label_margin_top"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:maxLines="1"
        android:shadowColor="@color/text_shadow"
        android:shadowRadius="8"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/setting_label_text_size" />
</LinearLayout>
