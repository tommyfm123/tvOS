<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android"
    android:enterFadeDuration="150"
    android:exitFadeDuration="150">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <stroke
                android:width="@dimen/glass_stroke_width"
                android:color="@color/card_border_focused" />
            <corners android:radius="@dimen/setting_card_corner" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke
                android:width="@dimen/glass_stroke_width"
                android:color="@color/glass_border" />
            <corners android:radius="@dimen/setting_card_corner" />
        </shape>
    </item>
</selector>
